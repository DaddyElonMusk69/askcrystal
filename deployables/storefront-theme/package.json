{
  "name": "@askcrystal/horizon-theme",
  "private": true,
  "version": "0.1.0",
  "description": "Native Shopify theme workspace for AskCrystal storefront development.",
  "scripts": {
    "shopify": "shopify",
    "agent:build": "vite build --config vite.askcrystal.config.mjs",
    "agent:watch": "vite build --config vite.askcrystal.config.mjs --watch",
    "theme:dev": "shopify theme dev --path .",
    "theme:dev:open": "shopify theme dev --path . --open",
    "theme:check": "shopify theme check --path .",
    "theme:package": "shopify theme package --path .",
    "theme:info": "shopify theme info --path ."
  },
  "engines": {
    "node": ">=20.10"
  },
  "devDependencies": {
    "@assistant-ui/react": "^0.11.7",
    "@shopify/cli": "^3.93.2",
    "@vitejs/plugin-react": "^5.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^7.1.3"
  }
}
