{% liquid
  assign intention_collections = section.settings.intention_collections
  if intention_collections == blank
    assign intention_collections = collections
  endif

  assign crystal_collections = section.settings.crystal_collections
  if crystal_collections == blank
    assign crystal_collections = collections
  endif

  assign form_collections = section.settings.form_collections
  if form_collections == blank
    assign form_collections = collections
  endif

  assign bestseller_collection = section.settings.bestseller_collection
  assign bestseller_handle = section.settings.bestseller_handle | default: 'best-sellers'
  if bestseller_collection == blank and collections[bestseller_handle] != blank
    assign bestseller_collection = collections[bestseller_handle]
  endif
  if bestseller_collection == blank
    assign bestseller_collection = collections.all
  endif

  assign collection_tab_limit = section.settings.collection_tab_limit | default: 8
  assign product_limit = section.settings.product_limit | default: 6
  assign crystal_tab_limit = section.settings.crystal_tab_limit | default: 5
  assign crystal_product_limit = section.settings.crystal_product_limit | default: 8
  assign form_tab_limit = section.settings.form_tab_limit | default: 5
  assign form_product_limit = section.settings.form_product_limit | default: 8
%}

{% style %}
  {% for collection in crystal_collections limit: crystal_tab_limit %}
    #AskCrystalCrystalTab-{{ section.id }}-{{ forloop.index }}:checked ~ .askcrystal-collections__crystal-tabs .askcrystal-collections__crystal-label--{{ forloop.index }} {
      border-color: rgb(228 183 107 / 0.82);
      background: rgb(185 149 96 / 0.16);
      color: var(--ac-shop-cream);
    }

    #AskCrystalCrystalTab-{{ section.id }}-{{ forloop.index }}:checked ~ .askcrystal-collections__crystal-tabs .askcrystal-collections__crystal-panel--{{ forloop.index }} {
      display: grid;
    }
  {% endfor %}

  {% for collection in form_collections limit: form_tab_limit %}
    #AskCrystalFormTab-{{ section.id }}-{{ forloop.index }}:checked ~ .askcrystal-collections__crystal-tabs .askcrystal-collections__form-label--{{ forloop.index }} {
      border-color: rgb(228 183 107 / 0.82);
      background: rgb(185 149 96 / 0.16);
      color: var(--ac-shop-cream);
    }

    #AskCrystalFormTab-{{ section.id }}-{{ forloop.index }}:checked ~ .askcrystal-collections__crystal-tabs .askcrystal-collections__form-panel--{{ forloop.index }} {
      display: grid;
    }
  {% endfor %}
{% endstyle %}

<section class="askcrystal-collections color-{{ section.settings.color_scheme }}">
  <div class="askcrystal-collections__hero">
    <div class="askcrystal-collections__stars" aria-hidden="true"></div>
    <div class="askcrystal-collections__zodiac" aria-hidden="true"></div>
    <div class="askcrystal-collections__crescent" aria-hidden="true"></div>
    <div class="askcrystal-collections__crystal-scene" aria-hidden="true">
      <span class="askcrystal-collections__crystal askcrystal-collections__crystal--main"></span>
      <span class="askcrystal-collections__crystal askcrystal-collections__crystal--left"></span>
      <span class="askcrystal-collections__crystal askcrystal-collections__crystal--right"></span>
      <span class="askcrystal-collections__stone"></span>
    </div>

    <div class="askcrystal-collections__hero-copy">
      <p class="askcrystal-collections__kicker">{{ section.settings.hero_kicker }}</p>
      <h1>{{ section.settings.heading }}</h1>
      <p class="askcrystal-collections__lede">{{ section.settings.description }}</p>
      <p class="askcrystal-collections__note">
        <span aria-hidden="true">✦</span>
        {{ section.settings.hero_note }}
      </p>
    </div>
  </div>

  <div class="askcrystal-collections__body">
    <section class="askcrystal-collections__intention" aria-labelledby="askcrystal-intentions-title-{{ section.id }}">
      <p class="askcrystal-collections__section-label" id="askcrystal-intentions-title-{{ section.id }}">{{ section.settings.intentions_heading }}</p>
      <div class="askcrystal-collections__intention-rail" role="list" aria-label="{{ section.settings.intentions_heading }}">
        {% for collection in intention_collections limit: collection_tab_limit %}
          {% liquid
            assign collection_image = collection.featured_image
            if collection_image == blank and collection.products.first != blank
              assign collection_image = collection.products.first.featured_media.preview_image
            endif
          %}
          <a class="askcrystal-collections__intention-card" href="{{ collection.url }}" role="listitem" aria-label="View all products in {{ collection.title | escape }}">
            <span class="askcrystal-collections__intention-orb" aria-hidden="true">
              {% if collection_image != blank %}
                {{
                  collection_image
                  | image_url: width: 180
                  | image_tag:
                    widths: '90, 140, 180',
                    sizes: '64px',
                    loading: 'lazy',
                    alt: ''
                }}
              {% else %}
                <span>{{ collection.title | slice: 0 | upcase }}</span>
              {% endif %}
            </span>
            <span class="askcrystal-collections__intention-copy">
              <span class="askcrystal-collections__intention-title">{{ collection.title }}</span>
              <span class="askcrystal-collections__intention-count">{{ collection.products_count }} pieces</span>
            </span>
          </a>
        {% else %}
          <a class="askcrystal-collections__intention-card" href="{{ routes.all_products_collection_url }}" role="listitem">
            <span class="askcrystal-collections__intention-orb" aria-hidden="true"><span>✦</span></span>
            <span class="askcrystal-collections__intention-copy">
              <span class="askcrystal-collections__intention-title">All pieces</span>
              <span class="askcrystal-collections__intention-count">Browse the shop</span>
            </span>
          </a>
        {% endfor %}
      </div>
    </section>

    <section class="askcrystal-collections__product-section" aria-labelledby="askcrystal-bestsellers-title-{{ section.id }}">
      <div class="askcrystal-collections__section-head">
        <p class="askcrystal-collections__section-label">{{ section.settings.bestsellers_kicker }}</p>
        <div>
          <h2 id="askcrystal-bestsellers-title-{{ section.id }}">{{ section.settings.bestsellers_heading }}</h2>
        </div>
        {% if bestseller_collection != blank %}
          <a class="askcrystal-collections__text-link" href="{{ bestseller_collection.url }}">View all</a>
        {% endif %}
      </div>

      <div class="askcrystal-collections__products" role="list">
        {% if bestseller_collection != blank %}
          {% for product in bestseller_collection.products limit: product_limit %}
            {% liquid
              assign product_image = product.featured_media.preview_image
              assign product_blurb = product.description | strip_html | strip | truncate: 76
              assign product_price = product.price | money_without_trailing_zeros
              assign product_price_min = product.price_min | money_without_trailing_zeros
            %}

            <article class="askcrystal-collections__product-card" role="listitem">
              <a class="askcrystal-collections__product-link" href="{{ product.url }}" aria-label="{{ product.title | escape }}">
                <span class="askcrystal-collections__badge">{{ section.settings.product_badge_text }}</span>
                <span class="askcrystal-collections__bookmark" aria-hidden="true">
                  <svg viewBox="0 0 24 32" focusable="false">
                    <path d="M4 3h16v25l-8-5-8 5V3Z" />
                  </svg>
                </span>

                <span class="askcrystal-collections__product-media">
                  {% if product_image != blank %}
                    {{
                      product_image
                      | image_url: width: 720
                      | image_tag:
                        widths: '240, 360, 480, 720',
                        sizes: '(min-width: 990px) 31vw, 47vw',
                        loading: 'lazy',
                        alt: product.title
                    }}
                  {% else %}
                    <span class="askcrystal-collections__product-placeholder">✦</span>
                  {% endif %}
                </span>

                <span class="askcrystal-collections__product-copy">
                  <span class="askcrystal-collections__product-title">
                    <span aria-hidden="true">✦</span>
                    {{ product.title }}
                  </span>
                  {% if product_blurb != blank %}
                    <span class="askcrystal-collections__product-blurb">{{ product_blurb }}</span>
                  {% endif %}
                  <span class="askcrystal-collections__price">
                    {% if product.price_varies %}
                      From {{ product_price_min }}
                    {% else %}
                      {{ product_price }}
                    {% endif %}
                  </span>
                </span>
              </a>
            </article>
          {% else %}
            <div class="askcrystal-collections__empty">
              <h2>No best sellers yet</h2>
              <p>Select a best-sellers collection in this section, or add products to your All collection.</p>
            </div>
          {% endfor %}
        {% else %}
          <div class="askcrystal-collections__empty">
            <h2>No best sellers yet</h2>
            <p>Select a best-sellers collection in this section, or add products to your All collection.</p>
          </div>
        {% endif %}
      </div>
    </section>

    <section class="askcrystal-collections__crystal-browse" aria-labelledby="askcrystal-crystal-title-{{ section.id }}">
      <div class="askcrystal-collections__section-head askcrystal-collections__section-head--stacked">
        <p class="askcrystal-collections__section-label">{{ section.settings.crystal_kicker }}</p>
        <div>
          <h2 id="askcrystal-crystal-title-{{ section.id }}">{{ section.settings.crystal_heading }}</h2>
        </div>
      </div>

      <div class="askcrystal-collections__crystal-shell">
        {% for collection in crystal_collections limit: crystal_tab_limit %}
          <input
            class="askcrystal-collections__crystal-input"
            type="radio"
            id="AskCrystalCrystalTab-{{ section.id }}-{{ forloop.index }}"
            name="AskCrystalCrystalTabs-{{ section.id }}"
            {% if forloop.first %}checked{% endif %}
          >
        {% endfor %}

        <div class="askcrystal-collections__crystal-tabs">
          <div class="askcrystal-collections__crystal-nav" role="tablist" aria-label="{{ section.settings.crystal_heading }}">
            {% for collection in crystal_collections limit: crystal_tab_limit %}
              <label
                class="askcrystal-collections__crystal-label askcrystal-collections__crystal-label--{{ forloop.index }}"
                for="AskCrystalCrystalTab-{{ section.id }}-{{ forloop.index }}"
                role="tab"
              >
                {{ collection.title }}
              </label>
            {% else %}
              <a class="askcrystal-collections__crystal-label" href="{{ routes.all_products_collection_url }}">All crystals</a>
            {% endfor %}
          </div>

          <div class="askcrystal-collections__crystal-panels">
            {% for collection in crystal_collections limit: crystal_tab_limit %}
              <div class="askcrystal-collections__crystal-panel askcrystal-collections__crystal-panel--{{ forloop.index }}" role="tabpanel">
                <div class="askcrystal-collections__crystal-panel-header">
                  <div>
                    <h3>{{ collection.title }}</h3>
                  </div>
                  <a class="askcrystal-collections__text-link" href="{{ collection.url }}">View all</a>
                </div>

                <div class="askcrystal-collections__crystal-carousel" role="list">
                  {% for product in collection.products limit: crystal_product_limit %}
                    {% liquid
                      assign product_image = product.featured_media.preview_image
                      assign product_price = product.price | money_without_trailing_zeros
                      assign product_price_min = product.price_min | money_without_trailing_zeros
                    %}
                    <article class="askcrystal-collections__mini-card" role="listitem">
                      <a href="{{ product.url }}" aria-label="{{ product.title | escape }}">
                        <span class="askcrystal-collections__mini-media">
                          {% if product_image != blank %}
                            {{
                              product_image
                              | image_url: width: 420
                              | image_tag:
                                widths: '180, 260, 360, 420',
                                sizes: '42vw',
                                loading: 'lazy',
                                alt: product.title
                            }}
                          {% else %}
                            <span>✦</span>
                          {% endif %}
                        </span>
                        <span class="askcrystal-collections__mini-title">{{ product.title }}</span>
                        <span class="askcrystal-collections__mini-price">
                          {% if product.price_varies %}
                            From {{ product_price_min }}
                          {% else %}
                            {{ product_price }}
                          {% endif %}
                        </span>
                      </a>
                    </article>
                  {% else %}
                    <div class="askcrystal-collections__empty askcrystal-collections__empty--compact">
                      <h2>No pieces here yet</h2>
                      <p>Add products to this collection when the material shelves are ready.</p>
                    </div>
                  {% endfor %}
                </div>
              </div>
            {% endfor %}
          </div>
        </div>
      </div>
    </section>

    <section class="askcrystal-collections__crystal-browse" aria-labelledby="askcrystal-form-title-{{ section.id }}">
      <div class="askcrystal-collections__section-head askcrystal-collections__section-head--stacked">
        <p class="askcrystal-collections__section-label">{{ section.settings.form_kicker }}</p>
        <div>
          <h2 id="askcrystal-form-title-{{ section.id }}">{{ section.settings.form_heading }}</h2>
        </div>
      </div>

      <div class="askcrystal-collections__crystal-shell">
        {% for collection in form_collections limit: form_tab_limit %}
          <input
            class="askcrystal-collections__crystal-input"
            type="radio"
            id="AskCrystalFormTab-{{ section.id }}-{{ forloop.index }}"
            name="AskCrystalFormTabs-{{ section.id }}"
            {% if forloop.first %}checked{% endif %}
          >
        {% endfor %}

        <div class="askcrystal-collections__crystal-tabs">
          <div class="askcrystal-collections__crystal-nav" role="tablist" aria-label="{{ section.settings.form_heading }}">
            {% for collection in form_collections limit: form_tab_limit %}
              <label
                class="askcrystal-collections__crystal-label askcrystal-collections__form-label--{{ forloop.index }}"
                for="AskCrystalFormTab-{{ section.id }}-{{ forloop.index }}"
                role="tab"
              >
                {{ collection.title }}
              </label>
            {% else %}
              <a class="askcrystal-collections__crystal-label" href="{{ routes.all_products_collection_url }}">All forms</a>
            {% endfor %}
          </div>

          <div class="askcrystal-collections__crystal-panels">
            {% for collection in form_collections limit: form_tab_limit %}
              <div class="askcrystal-collections__crystal-panel askcrystal-collections__form-panel--{{ forloop.index }}" role="tabpanel">
                <div class="askcrystal-collections__crystal-panel-header">
                  <div>
                    <h3>{{ collection.title }}</h3>
                  </div>
                  <a class="askcrystal-collections__text-link" href="{{ collection.url }}">View all</a>
                </div>

                <div class="askcrystal-collections__crystal-carousel" role="list">
                  {% for product in collection.products limit: form_product_limit %}
                    {% liquid
                      assign product_image = product.featured_media.preview_image
                      assign product_price = product.price | money_without_trailing_zeros
                      assign product_price_min = product.price_min | money_without_trailing_zeros
                    %}
                    <article class="askcrystal-collections__mini-card" role="listitem">
                      <a href="{{ product.url }}" aria-label="{{ product.title | escape }}">
                        <span class="askcrystal-collections__mini-media">
                          {% if product_image != blank %}
                            {{
                              product_image
                              | image_url: width: 420
                              | image_tag:
                                widths: '180, 260, 360, 420',
                                sizes: '42vw',
                                loading: 'lazy',
                                alt: product.title
                            }}
                          {% else %}
                            <span>✦</span>
                          {% endif %}
                        </span>
                        <span class="askcrystal-collections__mini-title">{{ product.title }}</span>
                        <span class="askcrystal-collections__mini-price">
                          {% if product.price_varies %}
                            From {{ product_price_min }}
                          {% else %}
                            {{ product_price }}
                          {% endif %}
                        </span>
                      </a>
                    </article>
                  {% else %}
                    <div class="askcrystal-collections__empty askcrystal-collections__empty--compact">
                      <h2>No pieces here yet</h2>
                      <p>Add products when these form collections are ready.</p>
                    </div>
                  {% endfor %}
                </div>
              </div>
            {% endfor %}
          </div>
        </div>
      </div>
    </section>

    <section class="askcrystal-collections__standard" aria-labelledby="askcrystal-standard-title-{{ section.id }}">
      <div class="askcrystal-collections__standard-heading">
        <span aria-hidden="true"></span>
        <h2 id="askcrystal-standard-title-{{ section.id }}">Our Standard</h2>
        <span aria-hidden="true"></span>
      </div>
      <div class="askcrystal-collections__standard-grid">
        <article>
          <svg viewBox="0 0 54 54" aria-hidden="true" focusable="false">
            <path d="M27 5 42 22 27 50 12 22 27 5Z" />
            <path d="M12 22h30M20 22l7 28 7-28M27 5v17M11 36c-5-1-8-4-9-9 6 0 10 3 12 8M43 36c5-1 8-4 9-9-6 0-10 3-12 8" />
          </svg>
          <h3>Ethically Sourced</h3>
          <p>We work with trusted makers and conscious suppliers.</p>
        </article>
        <article>
          <svg viewBox="0 0 54 54" aria-hidden="true" focusable="false">
            <path d="M27 8 39 21 27 44 15 21 27 8Z" />
            <path d="M9 36c5 7 11 10 18 10s13-3 18-10M15 31l-7-4M39 31l7-4" />
          </svg>
          <h3>Hand-Selected</h3>
          <p>Each piece is chosen for quality, energy, and beauty.</p>
        </article>
        <article>
          <svg viewBox="0 0 54 54" aria-hidden="true" focusable="false">
            <path d="M34 7c-9 3-15 11-15 21s6 18 15 21c-14 0-25-9-25-21S20 7 34 7Z" />
            <path d="M40 13v10M35 18h10M42 32v8M38 36h8" />
          </svg>
          <h3>Energetically Cleansed</h3>
          <p>Cleansed and charged before it reaches your hands.</p>
        </article>
        <article>
          <svg viewBox="0 0 54 54" aria-hidden="true" focusable="false">
            <path d="M27 4 43 20 27 50 11 20 27 4Z" />
            <path d="M11 20h32M19 20l8 30 8-30M27 4v16M7 39c5-7 12-10 20-10s15 3 20 10" />
          </svg>
          <h3>Never Mass-Grade</h3>
          <p>Only high-grade stones, never commercial filler.</p>
        </article>
      </div>
    </section>

    <section class="askcrystal-collections__guidance" aria-labelledby="askcrystal-guidance-title-{{ section.id }}">
      <div class="askcrystal-collections__eye" aria-hidden="true">
        <span></span>
      </div>
      <div class="askcrystal-collections__guidance-copy">
        <h2 id="askcrystal-guidance-title-{{ section.id }}">Not sure what resonates?</h2>
        <p>Ask AskCrystal for personalized guidance.</p>
        <a href="{{ section.settings.guidance_url }}" class="askcrystal-collections__guidance-button">
          <span aria-hidden="true">✦</span>
          {{ section.settings.guidance_label }}
        </a>
      </div>
    </section>

    <section class="askcrystal-collections__trust" aria-label="Store promises">
      <article>
        <span aria-hidden="true">
          <svg viewBox="0 0 42 42" focusable="false"><path d="M21 5 34 10v10c0 8-5 14-13 17C13 34 8 28 8 20V10l13-5Z" /><path d="m16 21 4 4 7-9" /></svg>
        </span>
        <div>
          <h3>Secure & Private</h3>
          <p>Your data and purchases are always protected.</p>
        </div>
      </article>
      <article>
        <span aria-hidden="true">
          <svg viewBox="0 0 42 42" focusable="false"><path d="m7 13 14-8 14 8-14 8-14-8Z" /><path d="M7 13v16l14 8 14-8V13M21 21v16" /></svg>
        </span>
        <div>
          <h3>Insured Shipping</h3>
          <p>Carefully packaged and fully insured delivery.</p>
        </div>
      </article>
      <article>
        <span aria-hidden="true">
          <svg viewBox="0 0 42 42" focusable="false"><path d="M31 13a13 13 0 1 0 3 12" /><path d="M30 6v8h8M14 21c2 5 12 5 14 0" /></svg>
        </span>
        <div>
          <h3>Love It or Return</h3>
          <p>30-day return window on all eligible items.</p>
        </div>
      </article>
    </section>

    <nav class="askcrystal-collections__link-panel" aria-label="Store links">
      <details open>
        <summary>Shop</summary>
        <a href="{{ routes.all_products_collection_url }}">All products</a>
        <a href="{{ bestseller_collection.url | default: routes.all_products_collection_url }}">Best sellers</a>
      </details>
      <details>
        <summary>About AskCrystal</summary>
        <a href="{{ section.settings.guidance_url }}">Ask for guidance</a>
        <a href="{{ routes.root_url }}">Return to chat</a>
      </details>
      <details>
        <summary>Customer Care</summary>
        <a href="{{ routes.cart_url }}">Cart</a>
        <a href="{{ routes.search_url }}">Search</a>
      </details>
      <details>
        <summary>Resources</summary>
        <a href="{{ routes.root_url }}">Energy readings</a>
        <a href="{{ routes.all_products_collection_url }}">Crystal shelf</a>
      </details>
    </nav>
  </div>
</section>

{% stylesheet %}
  .askcrystal-collections {
    --ac-shop-night: #020c14;
    --ac-shop-night-soft: #061520;
    --ac-shop-gold: #b99560;
    --ac-shop-gold-bright: #e4b76b;
    --ac-shop-cream: #f0dfc8;
    --ac-shop-muted: rgb(240 223 200 / 0.72);
    --ac-shop-line: rgb(185 149 96 / 0.48);
    --ac-shop-line-soft: rgb(185 149 96 / 0.26);
    --ac-shop-card: linear-gradient(180deg, rgb(7 22 33 / 0.96), rgb(2 12 20 / 0.98));
    --ac-shop-radius-lg: 24px;
    --ac-shop-radius-md: 18px;
    --ac-shop-radius-sm: 12px;

    position: relative;
    overflow: clip;
    min-height: 100vh;
    color: var(--ac-shop-cream);
    background:
      radial-gradient(circle at 74% 8%, rgb(185 149 96 / 0.13), transparent 24rem),
      radial-gradient(circle at 14% 18%, rgb(185 149 96 / 0.08), transparent 18rem),
      linear-gradient(180deg, var(--ac-shop-night) 0%, #03111b 48%, var(--ac-shop-night) 100%);
  }

  .askcrystal-collections a {
    color: inherit;
  }

  .askcrystal-collections__hero {
    position: relative;
    isolation: isolate;
    min-height: clamp(330px, 43vw, 480px);
    padding: clamp(4.3rem, 10vw, 7rem) clamp(1.38rem, 5vw, 4rem) clamp(1.55rem, 4.4vw, 3rem);
    border-bottom: 1px solid rgb(185 149 96 / 0.22);
    background:
      linear-gradient(90deg, rgb(2 12 20 / 0.98) 0%, rgb(2 12 20 / 0.76) 46%, rgb(2 12 20 / 0.28) 100%),
      radial-gradient(circle at 80% 35%, rgb(185 149 96 / 0.17), transparent 18rem);
  }

  .askcrystal-collections__stars,
  .askcrystal-collections__zodiac,
  .askcrystal-collections__crescent,
  .askcrystal-collections__crystal-scene {
    position: absolute;
    pointer-events: none;
  }

  .askcrystal-collections__stars {
    inset: 0;
    z-index: -2;
    opacity: 0.72;
    background-image:
      radial-gradient(circle at 18% 26%, rgb(228 183 107 / 0.72) 0 1px, transparent 1.4px),
      radial-gradient(circle at 72% 18%, rgb(240 223 200 / 0.68) 0 1px, transparent 1.5px),
      radial-gradient(circle at 84% 56%, rgb(185 149 96 / 0.58) 0 1px, transparent 1.6px),
      radial-gradient(circle at 42% 72%, rgb(228 183 107 / 0.45) 0 1px, transparent 1.5px);
    background-size: 120px 110px, 180px 150px, 150px 170px, 210px 160px;
  }

  .askcrystal-collections__zodiac {
    z-index: -1;
    inset-inline-start: clamp(-8rem, -10vw, -3rem);
    top: clamp(3.5rem, 10vw, 6rem);
    width: clamp(15rem, 34vw, 26rem);
    aspect-ratio: 1;
    border: 1px solid rgb(185 149 96 / 0.14);
    border-radius: 50%;
    box-shadow:
      inset 0 0 0 22px rgb(185 149 96 / 0.025),
      inset 0 0 0 38px rgb(185 149 96 / 0.045),
      inset 0 0 0 62px rgb(185 149 96 / 0.025);
    opacity: 0.9;
  }

