    color: var(--ac-shop-gold-bright);
  }

  .askcrystal-collections__trust svg {
    width: 100%;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.45;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .askcrystal-collections__trust p {
    margin: 0.26rem 0 0;
    color: var(--ac-shop-muted);
    font-size: 0.92rem;
    line-height: 1.42;
  }

  .askcrystal-collections__trust h3 {
    color: var(--ac-shop-gold-bright);
  }

  .askcrystal-collections__link-panel {
    display: grid;
    padding: 0 1.15rem;
  }

  .askcrystal-collections__link-panel details {
    padding-block: 1rem;
  }

  .askcrystal-collections__link-panel details + details {
    border-top: 1px solid rgb(185 149 96 / 0.18);
  }

  .askcrystal-collections__link-panel summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    color: var(--ac-shop-gold-bright);
    cursor: pointer;
    list-style: none;
  }

  .askcrystal-collections__link-panel summary::-webkit-details-marker {
    display: none;
  }

  .askcrystal-collections__link-panel summary::after {
    content: "⌄";
    font-family: var(--font-body--family), sans-serif;
    font-size: 1rem;
    line-height: 1;
    transition: transform 180ms ease;
  }

  .askcrystal-collections__link-panel details[open] summary::after {
    transform: rotate(180deg);
  }

  .askcrystal-collections__link-panel a {
    display: block;
    width: fit-content;
    margin-top: 0.72rem;
    color: var(--ac-shop-muted);
    font-size: 0.9rem;
    text-decoration: none;
  }

  @media screen and (min-width: 750px) {
    .askcrystal-collections__section-head {
      grid-template-columns: minmax(0, 1fr) auto;
    }

    .askcrystal-collections__section-head .askcrystal-collections__section-label,
    .askcrystal-collections__section-head--stacked .askcrystal-collections__section-label {
      grid-column: 1 / -1;
    }

    .askcrystal-collections__intention-rail {
      grid-auto-flow: initial;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      overflow: visible;
      padding-bottom: 0;
    }

    .askcrystal-collections__products {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .askcrystal-collections__trust {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .askcrystal-collections__crystal-panel-header {
      grid-template-columns: minmax(0, 1fr) auto;
    }

    .askcrystal-collections__mini-card {
      flex-basis: min(21vw, 13.5rem);
    }

    .askcrystal-collections__standard-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .askcrystal-collections__standard-grid article + article {
      border-inline-start: 1px solid rgb(185 149 96 / 0.2);
    }

    .askcrystal-collections__trust {
      padding: 1.2rem 1.35rem;
    }

    .askcrystal-collections__trust article {
      padding-block: 0.35rem;
    }

    .askcrystal-collections__trust article + article {
      border-top: 0;
      border-inline-start: 1px solid rgb(185 149 96 / 0.25);
      padding-inline-start: 1.25rem;
    }
  }

  @media screen and (max-width: 749px) {
    .askcrystal-collections__hero {
      min-height: 24rem;
    }

    .askcrystal-collections__hero-copy {
      max-width: 92%;
    }

    .askcrystal-collections__crystal-scene {
      right: -1.6rem;
      bottom: 0.25rem;
      width: 12.8rem;
      height: 11.8rem;
      opacity: 0.38;
    }

    .askcrystal-collections__crescent {
      opacity: 0.58;
    }

    .askcrystal-collections__product-copy {
      padding: 0.66rem 0.68rem 0.76rem;
    }

    .askcrystal-collections__product-blurb {
      -webkit-line-clamp: 2;
    }

    .askcrystal-collections__guidance {
      grid-template-columns: 1fr;
    }

    .askcrystal-collections__eye {
      min-height: 5.2rem;
      max-width: 13rem;
    }

  }

  @media (prefers-reduced-motion: reduce) {
    .askcrystal-collections *,
    .askcrystal-collections *::before,
    .askcrystal-collections *::after {
      transition-duration: 1ms !important;
      scroll-behavior: auto !important;
    }
  }
{% endstylesheet %}

