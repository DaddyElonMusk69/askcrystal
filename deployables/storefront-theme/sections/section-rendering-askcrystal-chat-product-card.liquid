{% comment %}
  AskCrystal chat product card renderer.

  This section intentionally renders a compact chat-specific card while still
  using Horizon's native commerce primitives (`product-card`, `product-title`,
  `product-price`). The visual treatment is tuned for in-chat recommendations,
  especially on mobile.
{% endcomment %}

{% liquid
  assign requested_handle = blank
  if request.query_string contains 'askcrystal_handle='
    assign requested_handle = request.query_string | split: 'askcrystal_handle=' | last | split: '&' | first | url_decode
  endif

  assign requested_cta_label = 'View'
  if request.query_string contains 'askcrystal_cta='
    assign requested_cta_label = request.query_string | split: 'askcrystal_cta=' | last | split: '&' | first | url_decode | strip
    if requested_cta_label == blank
      assign requested_cta_label = 'View'
    endif
  endif

  if requested_handle != blank
    assign requested_product = all_products[requested_handle]
    if requested_product != blank
      assign product = requested_product
    endif
  endif

  if product == blank
    assign product = closest.product
  endif

  assign requested_variant_id = blank
  if request.query_string contains 'variant='
    assign requested_variant_id = request.query_string | split: 'variant=' | last | split: '&' | first | plus: 0
  endif

  if product != blank
    assign selected_variant = blank
    if requested_variant_id != blank
      assign selected_variant = product.variants | where: 'id', requested_variant_id | first
    endif
    if selected_variant == blank
      assign selected_variant = product.selected_or_first_available_variant
    endif
    if selected_variant == blank
      assign selected_variant = product.first_available_variant
    endif

    assign product_url = selected_variant.url
    unless product_url
      assign product_url = product.url
    endunless

    assign featured_media = selected_variant.featured_media
    if featured_media == blank
      assign featured_media = product.featured_media
    endif

    assign featured_image = featured_media.preview_image | default: product.featured_image
  endif
%}

<div
  class="askcrystal-chat-product-card"
  data-askcrystal-native-product-card
  data-section-rendering-id="section-rendering-askcrystal-chat-product-card"
>
  {% if product != blank %}
    <product-card
      class="product-card askcrystal-chat-product-card__card"
      data-product-id="{{ product.id }}"
    >
      <div
        class="product-card__content product-grid__card askcrystal-chat-product-card__content"
        style="
          --product-card-gap: 12px;
          --product-card-alignment: stretch;
          --padding-block-start: 0px;
          --padding-block-end: 0px;
          --padding-inline-start: 0px;
          --padding-inline-end: 0px;
        "
      >
        {% if product_url %}
          <a class="askcrystal-chat-product-card__surface" href="{{ product_url }}" ref="productCardLink">
        {% else %}
          <div class="askcrystal-chat-product-card__surface">
        {% endif %}
          <div class="askcrystal-chat-product-card__media">
            {% if featured_image != blank %}
              {{
                featured_image
                | image_url: width: 960
                | image_tag:
                  class: 'askcrystal-chat-product-card__image',
                  loading: 'lazy',
                  widths: '320, 480, 640, 960',
                  sizes: '(min-width: 750px) 420px, 100vw',
                  alt: featured_image.alt | default: product.title,
                  ref: 'imagesToTransition'
              }}
            {% else %}
              <div class="askcrystal-chat-product-card__placeholder">
                {{ 'content.product_card_placeholder' | t }}
              </div>
            {% endif %}
          </div>

          <div class="askcrystal-chat-product-card__body">
            <product-title class="askcrystal-chat-product-card__title">
              <span class="title-text">
                {{ product.title }}
              </span>
            </product-title>

            <div class="askcrystal-chat-product-card__meta">
              <div class="askcrystal-chat-product-card__price-group">
                <product-price
                  class="askcrystal-chat-product-card__price"
                  data-product-id="{{ product.id }}"
                >
                  {% render 'price', product_resource: product, show_unit_price: false, show_sale_price_first: true %}
                </product-price>
              </div>

              <span class="askcrystal-chat-product-card__cta">
                {{ requested_cta_label }}
              </span>
            </div>
          </div>
        {% if product_url %}
          </a>
        {% else %}
          </div>
        {% endif %}
      </div>
    </product-card>
  {% endif %}
</div>

{% schema %}
{
  "name": "AskCrystal chat card",
  "tag": "div",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Product"
    }
  ],
  "presets": [
    {
      "name": "AskCrystal chat card"
    }
  ]
}
{% endschema %}
