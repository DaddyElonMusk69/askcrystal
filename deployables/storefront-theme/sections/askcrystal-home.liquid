{% liquid
  assign featured_collection = section.settings.featured_collection
  assign shelf_collection = featured_collection
  assign quick_collection_1 = section.settings.quick_collection_1
  assign quick_collection_2 = section.settings.quick_collection_2
  assign quick_collection_3 = section.settings.quick_collection_3
  assign quick_collection_4 = section.settings.quick_collection_4
  assign browse_url = section.settings.browse_url

  if shelf_collection == blank and collections['best-sellers'] != blank
    assign shelf_collection = collections['best-sellers']
  endif

  if shelf_collection == blank
    assign shelf_collection = collections.all
  endif

  if quick_collection_1 == blank and collections['best-sellers'] != blank
    assign quick_collection_1 = collections['best-sellers']
  endif

  if quick_collection_1 == blank
    assign quick_collection_1 = collections.all
  endif

  if quick_collection_2 == blank and collections['bracelets'] != blank
    assign quick_collection_2 = collections['bracelets']
  endif

  if quick_collection_2 == blank and collections['necklaces'] != blank
    assign quick_collection_2 = collections['necklaces']
  endif

  if quick_collection_2 == blank
    assign quick_collection_2 = collections.all
  endif

  if quick_collection_3 == blank and collections['necklaces'] != blank
    assign quick_collection_3 = collections['necklaces']
  endif

  if quick_collection_3 == blank and collections['calm-crystals'] != blank
    assign quick_collection_3 = collections['calm-crystals']
  endif

  if quick_collection_3 == blank
    assign quick_collection_3 = collections.all
  endif

  if quick_collection_4 == blank and collections['calm-crystals'] != blank
    assign quick_collection_4 = collections['calm-crystals']
  endif

  if quick_collection_4 == blank and collections['abundance-crystals'] != blank
    assign quick_collection_4 = collections['abundance-crystals']
  endif

  if quick_collection_4 == blank and collections['clear-quartz-crystals'] != blank
    assign quick_collection_4 = collections['clear-quartz-crystals']
  endif

  if quick_collection_4 == blank
    assign quick_collection_4 = collections.all
  endif

  assign quick_collection_1_image = quick_collection_1.featured_image
  if quick_collection_1_image == blank and quick_collection_1.products.first != blank
    assign quick_collection_1_image = quick_collection_1.products.first.featured_media.preview_image
  endif

  assign quick_collection_2_image = quick_collection_2.featured_image
  if quick_collection_2_image == blank and quick_collection_2.products.first != blank
    assign quick_collection_2_image = quick_collection_2.products.first.featured_media.preview_image
  endif

  assign quick_collection_3_image = quick_collection_3.featured_image
  if quick_collection_3_image == blank and quick_collection_3.products.first != blank
    assign quick_collection_3_image = quick_collection_3.products.first.featured_media.preview_image
  endif

  assign quick_collection_4_image = quick_collection_4.featured_image
  if quick_collection_4_image == blank and quick_collection_4.products.first != blank
    assign quick_collection_4_image = quick_collection_4.products.first.featured_media.preview_image
  endif

  if browse_url == blank
    assign browse_url = '/collections'
  endif
%}

{% capture products_json %}
[ 
  {% if shelf_collection != blank %}
    {% for product in shelf_collection.products limit: section.settings.product_limit %}
      {% liquid
        assign product_image = product.featured_media.preview_image | default: product.featured_image
        assign product_artist = product.metafields.askcrystal.artist.value
        assign product_story_summary = product.metafields.askcrystal.story_summary.value
        assign product_badge = 'AskCrystal edit'

        if product_artist != blank and product_artist.name.value != blank
          assign product_badge = product_artist.name.value | append: ' edit'
        endif
      %}
      {
        "id": {{ product.id | json }},
        "title": {{ product.title | json }},
        "url": {{ product.url | json }},
        "image": {% if product_image != blank %}{{ product_image | image_url: width: 960 | json }}{% else %}null{% endif %},
        "price": {{ product.price | money_without_trailing_zeros | json }},
        "badge": {{ product_badge | json }},
        "summary": {{ product_story_summary | default: product.description | strip_html | replace: '"', '' | strip | truncatewords: 18 | json }}
      }{% unless forloop.last %},{% endunless %}
    {% endfor %}
  {% endif %}
]
{% endcapture %}

{% capture quick_collection_3_products_json %}
[
  {% if quick_collection_3 != blank %}
    {% for product in quick_collection_3.products limit: 3 %}
      {% liquid
        assign quick_product_image = product.featured_media.preview_image | default: product.featured_image
      %}
      {
        "id": {{ product.id | json }},
        "title": {{ product.title | json }},
        "url": {{ product.url | json }},
        "image": {% if quick_product_image != blank %}{{ quick_product_image | image_url: width: 560 | json }}{% else %}null{% endif %},
        "price": {{ product.price | money_without_trailing_zeros | json }}
      }{% unless forloop.last %},{% endunless %}
    {% endfor %}
  {% endif %}
]
{% endcapture %}

