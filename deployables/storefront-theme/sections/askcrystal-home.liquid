<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  class="section section--full-width spacing-style color-{{ section.settings.color_scheme }} askcrystal-homepage-section"
  style="{% render 'spacing-style', settings: section.settings %}"
>
  {{ 'askcrystal-homepage.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'askcrystal-homepage.js' | asset_url }}" type="module" defer></script>

  <div class="askcrystal-homepage-section__inner">
    <div
      data-askcrystal-homepage-root
      data-section-id="{{ section.id }}"
      data-config-id="AskCrystalHomepageConfig-{{ section.id }}"
    ></div>
  </div>

  <script id="AskCrystalHomepageConfig-{{ section.id }}" type="application/json">
    {
      "sectionId": {{ section.id | json }},
      "displayMode": "home",
      "apiEndpoint": {{ section.settings.api_endpoint | json }},
      "chatPageUrl": {{ section.settings.chat_page_url | default: '/?askcrystal=chat' | json }},
      "homeUrl": {{ routes.root_url | json }},
      "eyebrow": {{ section.settings.eyebrow | json }},
      "heading": {{ section.settings.heading | json }},
      "headingLine1": {{ section.settings.heading_line_1 | default: 'Find the crystal, ritual, or reading' | json }},
      "headingLine2Prefix": {{ section.settings.heading_line_2_prefix | default: 'that meets' | json }},
      "headingAccent": {{ section.settings.heading_accent | default: 'you' | json }},
      "headingSuffix": {{ section.settings.heading_suffix | default: 'where you are.' | json }},
      "description": {{ section.settings.description | json }},
      "note": {{ section.settings.note | json }},
      "shelfHeading": {{ section.settings.shelf_heading | json }},
      "shelfNote": {{ section.settings.shelf_note | json }},
      "browseUrl": {{ browse_url | json }},
      "quickCatalogsHeading": {{ section.settings.quick_catalogs_heading | json }},
      "quickCatalogsDescription": {{ section.settings.quick_catalogs_description | json }},
      "quickCatalogsBrowseLabel": {{ section.settings.quick_catalogs_browse_label | json }},
      "quickCatalogs": [
        {
          "id": {{ quick_collection_1.id | json }},
          "title": {{ quick_collection_1.title | json }},
          "url": {{ quick_collection_1.url | json }},
          "description": {{ quick_collection_1.description | strip_html | replace: '"', '' | strip | truncatewords: 18 | json }},
          "count": {{ quick_collection_1.products_count | json }},
          "image": {% if quick_collection_1_image != blank %}{{ quick_collection_1_image | image_url: width: 720 | json }}{% else %}null{% endif %},
          "previewProducts": {{ quick_collection_1_products_json | strip }}
        },
        {
          "id": {{ quick_collection_2.id | json }},
          "title": {{ quick_collection_2.title | json }},
          "url": {{ quick_collection_2.url | json }},
          "description": {{ quick_collection_2.description | strip_html | replace: '"', '' | strip | truncatewords: 18 | json }},
          "count": {{ quick_collection_2.products_count | json }},
          "image": {% if quick_collection_2_image != blank %}{{ quick_collection_2_image | image_url: width: 720 | json }}{% else %}null{% endif %},
          "previewProducts": {{ quick_collection_2_products_json | strip }}
        },
        {
          "id": {{ quick_collection_3.id | json }},
          "title": {{ quick_collection_3.title | json }},
          "url": {{ quick_collection_3.url | json }},
          "description": {{ quick_collection_3.description | strip_html | replace: '"', '' | strip | truncatewords: 18 | json }},
          "count": {{ quick_collection_3.products_count | json }},
          "image": {% if quick_collection_3_image != blank %}{{ quick_collection_3_image | image_url: width: 720 | json }}{% else %}null{% endif %},
          "previewProducts": {{ quick_collection_3_products_json | strip }}
        },
        {
          "id": {{ quick_collection_4.id | json }},
          "title": {{ quick_collection_4.title | json }},
          "url": {{ quick_collection_4.url | json }},
          "description": {{ quick_collection_4.description | strip_html | replace: '"', '' | strip | truncatewords: 18 | json }},
          "count": {{ quick_collection_4.products_count | json }},
          "image": {% if quick_collection_4_image != blank %}{{ quick_collection_4_image | image_url: width: 720 | json }}{% else %}null{% endif %},
          "previewProducts": {{ quick_collection_4_products_json | strip }}
        }
      ],
      "suggestions": [
        {{ section.settings.suggestion_1 | json }},
        {{ section.settings.suggestion_2 | json }},
        {{ section.settings.suggestion_3 | json }},
        {{ section.settings.suggestion_4 | json }}
      ],
      "products": {{ products_json | strip }}
    }
  </script>

  <noscript>
    <div class="askcrystal-homepage-section__inner">
      <p>JavaScript is required to load the AskCrystal guided storefront chat.</p>
    </div>
  </noscript>
</div>

{% schema %}
{
  "name": "AskCrystal homepage agent",
  "tag": "section",
  "class": "section-wrapper",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "AskCrystal"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Find the crystal, ritual, or reading that meets you where you are."
    },
    {
      "type": "text",
      "id": "heading_line_1",
      "label": "Heading line 1",
      "default": "Find the crystal, ritual, or reading"
    },
    {
      "type": "text",
      "id": "heading_line_2_prefix",
      "label": "Heading line 2 prefix",
      "default": "that meets"
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "Heading accent",
      "default": "you"
    },
    {
      "type": "text",
      "id": "heading_suffix",
      "label": "Heading suffix",
      "default": "where you are."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "A guided crystal boutique with readings, artist-curated collections, and distinctive pieces selected for material character, ritual use, and personal resonance."
    },
    {
      "type": "textarea",
      "id": "note",
      "label": "Guide note",
      "default": "Start with a reading, browse curated collections, or explore best sellers selected from the AskCrystal artist edit."
    },
    {
      "type": "text",
      "id": "shelf_heading",
      "label": "Best sellers heading",
      "default": "Best sellers"
    },
    {
      "type": "textarea",
      "id": "shelf_note",
      "label": "Best sellers note",
      "default": "Customer favorites from the AskCrystal artist edit, chosen for distinctive materials, wearable ritual use, and a point of view you will only find here."
    },
    {
      "type": "text",
      "id": "quick_catalogs_heading",
      "label": "Collections heading",
      "default": "Curated collections"
    },
    {
      "type": "textarea",
      "id": "quick_catalogs_description",
      "label": "Collections description",
      "default": "Browse by form, intention, or material direction. Each collection gathers pieces selected for a sharper point of view than a standard product grid."
    },
    {
      "type": "text",
      "id": "quick_catalogs_browse_label",
      "label": "Collections browse label",
      "default": "View all collections"
    },
    {
      "type": "collection",
      "id": "featured_collection",
      "label": "Featured collection"
    },
    {
      "type": "collection",
      "id": "quick_collection_1",
      "label": "Collection card 1"
    },
    {
      "type": "collection",
      "id": "quick_collection_2",
      "label": "Collection card 2"
    },
    {
      "type": "collection",
      "id": "quick_collection_3",
      "label": "Collection card 3"
    },
    {
      "type": "collection",
      "id": "quick_collection_4",
      "label": "Collection card 4"
    },
    {
      "type": "range",
      "id": "product_limit",
      "label": "Products to show",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 8
    },
    {
      "type": "url",
      "id": "browse_url",
      "label": "Browse all link"
    },
    {
      "type": "header",
      "content": "Prompt suggestions"
    },
    {
      "type": "text",
      "id": "suggestion_1",
      "label": "Suggestion 1",
      "default": "Sleep & calm"
    },
    {
      "type": "text",
      "id": "suggestion_2",
      "label": "Suggestion 2",
      "default": "Love reading"
    },
    {
      "type": "text",
      "id": "suggestion_3",
      "label": "Suggestion 3",
      "default": "Protection"
    },
    {
      "type": "text",
      "id": "suggestion_4",
      "label": "Suggestion 4",
      "default": "Work focus"
    },
    {
      "type": "header",
      "content": "Runtime"
    },
    {
      "type": "text",
      "id": "api_endpoint",
      "label": "Proxy endpoint",
      "default": "/apps/askcrystal/chat"
    },
    {
      "type": "url",
      "id": "chat_page_url",
      "label": "Chat page link"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "AskCrystal homepage agent",
      "category": "Custom"
    }
  ]
}
{% endschema %}
