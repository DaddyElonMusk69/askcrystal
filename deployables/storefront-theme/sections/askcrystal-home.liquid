{% liquid
  assign featured_collection = section.settings.featured_collection
  assign shelf_collection = featured_collection
  assign browse_url = section.settings.browse_url

  if shelf_collection == blank
    assign shelf_collection = collections.all
  endif

  if browse_url == blank
    assign browse_url = '/collections'
  endif
%}

{% capture products_json %}
[
  {% if shelf_collection != blank %}
    {% for product in shelf_collection.products limit: section.settings.product_limit %}
      {% liquid
        assign product_image = product.featured_media.preview_image | default: product.featured_image
      %}
      {
        "id": {{ product.id | json }},
        "title": {{ product.title | json }},
        "url": {{ product.url | json }},
        "image": {% if product_image != blank %}{{ product_image | image_url: width: 960 | json }}{% else %}null{% endif %},
        "price": {{ product.price | money_without_trailing_zeros | json }},
        "badge": {{ product.type | default: product.vendor | default: 'Featured Crystal' | json }},
        "summary": {{ product.description | strip_html | replace: '"', '' | strip | truncatewords: 16 | json }}
      }{% unless forloop.last %},{% endunless %}
    {% endfor %}
  {% endif %}
]
{% endcapture %}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  class="section section--full-width spacing-style color-{{ section.settings.color_scheme }} askcrystal-homepage-section"
  style="{% render 'spacing-style', settings: section.settings %}"
>
  {{ 'askcrystal-homepage.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'askcrystal-homepage.js' | asset_url }}" type="module" defer></script>

  <div class="askcrystal-homepage-section__inner">
    <div
      data-askcrystal-homepage-root
      data-section-id="{{ section.id }}"
      data-config-id="AskCrystalHomepageConfig-{{ section.id }}"
    ></div>
  </div>

  <script id="AskCrystalHomepageConfig-{{ section.id }}" type="application/json">
    {
      "sectionId": {{ section.id | json }},
      "displayMode": "home",
      "runtimeMode": {{ section.settings.runtime_mode | json }},
      "apiEndpoint": {{ section.settings.api_endpoint | json }},
      "chatPageUrl": {{ section.settings.chat_page_url | default: '/?askcrystal=chat' | json }},
      "homeUrl": {{ routes.root_url | json }},
      "eyebrow": {{ section.settings.eyebrow | json }},
      "heading": {{ section.settings.heading | json }},
      "headingLine1": {{ section.settings.heading_line_1 | default: 'Find the crystal, ritual, or reading' | json }},
      "headingLine2Prefix": {{ section.settings.heading_line_2_prefix | default: 'that meets' | json }},
      "headingAccent": {{ section.settings.heading_accent | default: 'you' | json }},
      "headingSuffix": {{ section.settings.heading_suffix | default: 'where you are.' | json }},
      "description": {{ section.settings.description | json }},
      "note": {{ section.settings.note | json }},
      "shelfHeading": {{ section.settings.shelf_heading | json }},
      "browseUrl": {{ browse_url | json }},
      "suggestions": [
        {{ section.settings.suggestion_1 | json }},
        {{ section.settings.suggestion_2 | json }},
        {{ section.settings.suggestion_3 | json }},
        {{ section.settings.suggestion_4 | json }}
      ],
      "products": {{ products_json | strip }}
    }
  </script>

  <noscript>
    <div class="askcrystal-homepage-section__inner">
      <p>JavaScript is required to load the AskCrystal guided storefront chat.</p>
    </div>
  </noscript>
</div>

{% schema %}
{
  "name": "AskCrystal homepage agent",
  "tag": "section",
  "class": "section-wrapper",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "AskCrystal"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Find the crystal, ritual, or reading that meets you where you are."
    },
    {
      "type": "text",
      "id": "heading_line_1",
      "label": "Heading line 1",
      "default": "Find the crystal, ritual, or reading"
    },
    {
      "type": "text",
      "id": "heading_line_2_prefix",
      "label": "Heading line 2 prefix",
      "default": "that meets"
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "Heading accent",
      "default": "you"
    },
    {
      "type": "text",
      "id": "heading_suffix",
      "label": "Heading suffix",
      "default": "where you are."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "A guided crystal boutique with a resident spiritual companion. Begin with a feeling, a question, or a life situation, and let the storefront respond with care and curation."
    },
    {
      "type": "textarea",
      "id": "note",
      "label": "Guide note",
      "default": "This scaffold keeps the store visible from the first screen. The guide can listen first, recommend later, and eventually hand off to richer catalog and ritual surfaces."
    },
    {
      "type": "text",
      "id": "shelf_heading",
      "label": "Shelf heading",
      "default": "Start with the shelf"
    },
    {
      "type": "collection",
      "id": "featured_collection",
      "label": "Featured collection"
    },
    {
      "type": "range",
      "id": "product_limit",
      "label": "Products to show",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 8
    },
    {
      "type": "url",
      "id": "browse_url",
      "label": "Browse all link"
    },
    {
      "type": "header",
      "content": "Prompt suggestions"
    },
    {
      "type": "text",
      "id": "suggestion_1",
      "label": "Suggestion 1",
      "default": "Sleep & calm"
    },
    {
      "type": "text",
      "id": "suggestion_2",
      "label": "Suggestion 2",
      "default": "Love reading"
    },
    {
      "type": "text",
      "id": "suggestion_3",
      "label": "Suggestion 3",
      "default": "Protection"
    },
    {
      "type": "text",
      "id": "suggestion_4",
      "label": "Suggestion 4",
      "default": "Work focus"
    },
    {
      "type": "header",
      "content": "Runtime"
    },
    {
      "type": "select",
      "id": "runtime_mode",
      "label": "Runtime mode",
      "default": "proxy",
      "options": [
        {
          "value": "demo",
          "label": "Demo scaffold"
        },
        {
          "value": "proxy",
          "label": "Backend proxy"
        }
      ]
    },
    {
      "type": "text",
      "id": "api_endpoint",
      "label": "Proxy endpoint",
      "default": "/apps/askcrystal/chat"
    },
    {
      "type": "url",
      "id": "chat_page_url",
      "label": "Chat page link"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "AskCrystal homepage agent",
      "category": "Custom"
    }
  ]
}
{% endschema %}
