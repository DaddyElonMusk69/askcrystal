{% liquid
  assign featured_collection = section.settings.featured_collection
  assign shelf_collection = featured_collection

  if shelf_collection == blank
    assign shelf_collection = collections.all
  endif
%}

{% capture products_json %}
[
  {% if shelf_collection != blank %}
    {% for product in shelf_collection.products limit: section.settings.product_limit %}
      {% liquid
        assign product_image = product.featured_media.preview_image | default: product.featured_image
      %}
      {
        "id": {{ product.id | json }},
        "title": {{ product.title | json }},
        "url": {{ product.url | json }},
        "image": {% if product_image != blank %}{{ product_image | image_url: width: 960 | json }}{% else %}null{% endif %},
        "price": {{ product.price | money_without_trailing_zeros | json }},
        "badge": {{ product.type | default: product.vendor | default: 'Featured Crystal' | json }},
        "summary": {{ product.description | strip_html | replace: '"', '' | strip | truncatewords: 16 | json }}
      }{% unless forloop.last %},{% endunless %}
    {% endfor %}
  {% endif %}
]
{% endcapture %}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  class="section section--full-width spacing-style color-{{ section.settings.color_scheme }} askcrystal-homepage-section askcrystal-chat-page-section"
  style="{% render 'spacing-style', settings: section.settings %}"
>
  {{ 'askcrystal-homepage.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'askcrystal-homepage.js' | asset_url }}" type="module" defer></script>

  <div class="askcrystal-homepage-section__inner">
    <div
      data-askcrystal-homepage-root
      data-section-id="{{ section.id }}"
      data-config-id="AskCrystalChatPageConfig-{{ section.id }}"
    ></div>
  </div>

  <script id="AskCrystalChatPageConfig-{{ section.id }}" type="application/json">
    {
      "sectionId": {{ section.id | json }},
      "displayMode": "chat",
      "runtimeMode": {{ section.settings.runtime_mode | json }},
      "apiEndpoint": {{ section.settings.api_endpoint | json }},
      "chatPageUrl": "/pages/askcrystal",
      "homeUrl": {{ routes.root_url | json }},
      "browseUrl": "/collections",
      "chatHeading": {{ section.settings.chat_heading | json }},
      "chatDescription": {{ section.settings.chat_description | json }},
      "products": {{ products_json | strip }}
    }
  </script>

  <noscript>
    <div class="askcrystal-homepage-section__inner">
      <p>JavaScript is required to load the AskCrystal reading room.</p>
    </div>
  </noscript>
</div>

{% schema %}
{
  "name": "AskCrystal chat page",
  "tag": "section",
  "class": "section-wrapper",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "chat_heading",
      "label": "Heading",
      "default": "AskCrystal reading room"
    },
    {
      "type": "textarea",
      "id": "chat_description",
      "label": "Description",
      "default": "Ask a question, name a feeling, or continue your last thread."
    },
    {
      "type": "collection",
      "id": "featured_collection",
      "label": "Demo fallback collection"
    },
    {
      "type": "range",
      "id": "product_limit",
      "label": "Demo fallback products",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 6
    },
    {
      "type": "header",
      "content": "Runtime"
    },
    {
      "type": "select",
      "id": "runtime_mode",
      "label": "Runtime mode",
      "default": "proxy",
      "options": [
        {
          "value": "demo",
          "label": "Demo scaffold"
        },
        {
          "value": "proxy",
          "label": "Backend proxy"
        }
      ]
    },
    {
      "type": "text",
      "id": "api_endpoint",
      "label": "Proxy endpoint",
      "default": "/apps/askcrystal/chat"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "AskCrystal chat page",
      "category": "Custom"
    }
  ]
}
{% endschema %}
