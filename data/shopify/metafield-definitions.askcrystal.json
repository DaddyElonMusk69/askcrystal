{
  "version": "2026-04-28",
  "namespace": "askcrystal",
  "owner_type": "PRODUCT",
  "notes": [
    "These are product-level metafield definitions for AskCrystal storefront storytelling and agent grounding.",
    "Do not duplicate native Shopify fields such as title, price, SKU, inventory, images, vendor, type, or collections.",
    "List fields are intended to be imported as JSON arrays in Shopify CSV or written through Admin API metafieldsSet."
  ],
  "definitions": [
    {
      "key": "primary_intention",
      "name": "AskCrystal Primary Intention",
      "type": "single_line_text_field",
      "required_for_launch": true,
      "allowed_values": ["calm", "protection", "love", "sleep", "grounding", "focus", "abundance", "clarity", "confidence", "emotional_healing", "intuition", "self_love", "emotional_balance"],
      "collection_facet": true,
      "facet_tag_prefix": "intention",
      "ui_slot": "Product hero, product story, recommendation logic",
      "example": "calm"
    },
    {
      "key": "secondary_intentions",
      "name": "AskCrystal Secondary Intentions",
      "type": "list.single_line_text_field",
