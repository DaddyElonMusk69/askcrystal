# AskCrystal shared environment template.
# Copy to .env for local/cloud runtime and fill the blank values.

# Runtime
NODE_ENV=production
ASKCRYSTAL_SHOPIFY_APP_PORT=8787
ASKCRYSTAL_SESSION_SECRET=replace-with-a-random-secret
ASKCRYSTAL_MEMORY_DATABASE_URL=

# Dify
# Local host runtime usually uses http://localhost:18080.
# Dockerized Shopify proxy should use ASKCRYSTAL_PROXY_DIFY_BASE_URL instead,
# because localhost inside the proxy container is the proxy container itself.
DIFY_BASE_URL=http://localhost:18080
ASKCRYSTAL_PROXY_DIFY_BASE_URL=http://host.docker.internal:18080
DIFY_APP_CHAT_URL=
DIFY_APP_API_KEY=
DIFY_APP_ID=
DIFY_ADMIN_EMAIL=
DIFY_ADMIN_PASSWORD=
DIFY_ADMIN_NAME=AskCrystal Admin
DIFY_DEV_USE_CONSOLE=false
DIFY_REQUEST_TIMEOUT_MS=120000
DIFY_SUGGESTED_QUESTIONS_REQUEST_TIMEOUT_MS=45000

# Shopify app/proxy
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_APP_URL=https://your-app-domain.example.com
SHOPIFY_APP_PROXY_PREFIX=/apps/askcrystal
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
SHOPIFY_PROXY_SIGNATURE_REQUIRED=true
ASKCRYSTAL_STOREFRONT_COMPONENT_PREVIEW_FALLBACK=false

# Optional Shopify admin scripts
SHOPIFY_ADMIN_ACCESS_TOKEN=
SHOPIFY_ADMIN_API_VERSION=2024-04
ASKCRYSTAL_PRODUCT_DESCRIPTION_DIR=
